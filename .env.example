# ============================================
# OLD MinIO Configuration
# ============================================
# Option 1: Full endpoint URL
OLD_ENDPOINT=http://old-minio:9000
OLD_REGION=us-east-1

# Option 2: Separate host + port + ssl (if using endpoint without protocol)
# OLD_ENDPOINT=old-minio
# OLD_PORT=9000
# OLD_USE_SSL=false

# Credentials - use either access keys OR root user/password
# Access Keys (preferred)
OLD_ACCESS_KEY=minioadmin
OLD_SECRET_KEY=minioadmin

# OR Root User + Password
# OLD_ROOT_USER=minioadmin
# OLD_ROOT_PASSWORD=minioadmin

# ============================================
# NEW MinIO Configuration
# ============================================
# Option 1: Full endpoint URL
NEW_ENDPOINT=http://new-minio:9000
NEW_REGION=us-east-1

# Option 2: Separate host + port + ssl (if using endpoint without protocol)
# NEW_ENDPOINT=new-minio
# NEW_PORT=9000
# NEW_USE_SSL=false

# Credentials - use either access keys OR root user/password
# Access Keys (preferred)
NEW_ACCESS_KEY=minioadmin
NEW_SECRET_KEY=minioadmin

# OR Root User + Password
# NEW_ROOT_USER=minioadmin
# NEW_ROOT_PASSWORD=minioadmin
